# The controller half of the hand-off
# (docs/decisions/0032-identity-sources-and-the-handoff.md §2).
#
# Before the service starts, the controller — this unit, running the
# ExecStartPre= line with the controller's token — mints a child token of
# the service's role and asks OpenBao to wrap it: what lands in
# RUNTIME_DIRECTORY is a wrapping token, good for one redemption within five
# seconds and for nothing else. The service redeems it as its first act
# (examples/handoff.rs). At every stop the controller revokes the service's
# token by the accessor ExecStartPre= wrote, whether the stop was clean, a
# crash, or the alarm.
#
# Install as a user unit for the proof on a workstation, or as a system
# unit with User= for a deployment. The controller token comes from
# %d/bao-controller (LoadCredential=), never from the environment, and
# ExecStartPre= and ExecStopPost= are the two lines that read it.

[Unit]
Description=weida hand-off example: redeem a wrapped OpenBao token, sign an identity, serve
After=network-online.target

[Service]
Type=exec
# The controller's token, loaded as the credential `bao-controller`: read by
# ExecStartPre= (to mint) and ExecStopPost= (to revoke) and by nothing else.
# Provisioned once, out of band.
LoadCredential=bao-controller:%h/.config/weida-handoff/controller.token
# Mint and wrap. The child is minted from the controller token with the
# service's role; the wrapping TTL is the window in which the service must
# start and redeem. The answer names the wrapping token and, as
# `wrapped_accessor`, the accessor of the child inside it — so the
# controller can revoke the child at exit without ever holding it, and
# whoever redeemed it. The wrapping token goes into RUNTIME_DIRECTORY, which
# ExecStartPre= can write (a credential is read-only): created 0700 for this
# unit's uid, private to it, removed with the unit. The service unlinks the
# file once redeemed.
ExecStartPre=/bin/sh -c 'umask 077; out=$(BAO_TOKEN=$(cat "$CREDENTIALS_DIRECTORY/bao-controller") bao token create -role=weida-handoff -metadata=unit=%n -wrap-ttl=5s -format=json) && printf "%%s" "$out" | sed -n "s/.*\\"wrapped_accessor\\": *\\"\\([^\\"]*\\)\\".*/\\1/p" > "$RUNTIME_DIRECTORY/accessor" && printf "%%s" "$out" | sed -n "s/.*\\"token\\": *\\"\\([^\\"]*\\)\\".*/\\1/p" > "$RUNTIME_DIRECTORY/bao-handoff"'
ExecStart=%h/.cargo/target/debug/examples/handoff
# Revoke the child by its accessor at every exit — clean, crash or alarm —
# which also kills whatever a thief redeemed.
ExecStopPost=/bin/sh -c 'test -s "$RUNTIME_DIRECTORY/accessor" && BAO_TOKEN=$(cat "$CREDENTIALS_DIRECTORY/bao-controller") bao token revoke -accessor "$(cat "$RUNTIME_DIRECTORY/accessor")" || true'
Environment=BAO_ADDR=http://127.0.0.1:8200
Environment=PKI_ROLE=weida-handoff
Environment=BIND=127.0.0.1:4433
RuntimeDirectory=weida-handoff
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
StateDirectory=weida-handoff
# Exit 3 is the alarm: the hand-off was stolen. Restart, and a restart is a
# new wrapping token; a real deployment alerts on this exit code.
Restart=on-failure
RestartSec=2s
# The residual risk the flow does not cover is the running process's
# memory against its own uid; these are the knobs for that.
NoNewPrivileges=yes
ProtectProc=invisible
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=default.target
